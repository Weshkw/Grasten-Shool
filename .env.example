# Copy to .env (or export in your shell) and adjust for your environment.
# With none of these set, the project runs in local development mode on SQLite.

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=school.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://school.example.com
DJANGO_TIME_ZONE=Africa/Nairobi
DJANGO_MEDIA_ROOT=/var/lib/grasten/media
# Set to false when a proxy in front of Django already redirects to HTTPS.
DJANGO_SECURE_SSL_REDIRECT=true

# Optional: use MySQL (pip install mysqlclient) or another database instead of SQLite.
DB_ENGINE=django.db.backends.mysql
DB_NAME=grasten
DB_USER=grasten
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306
